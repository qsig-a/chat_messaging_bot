# Copy to .env, fill in, and lock it down:
#
#   cp .env.example .env && chmod 600 .env
#
# This file is read two different ways — by Docker Compose (env_file) and by
# systemd (EnvironmentFile). Both want plain KEY=VALUE, so:
#   - no quotes around values (systemd strips them, Compose keeps them)
#   - no spaces around the =
#   - no `export`
#   - no inline comments after a value

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------

# Bot token from the Developer Portal (Bot tab).
DISCORD_TOKEN=

# Server the bot operates in. Messages from anywhere else are ignored.
# Enable Developer Mode in Discord, then right-click to copy IDs.
DISCORD_GUILD_ID=

# Channel that receives new-contact notices and delivery failures.
DISCORD_INBOX_CHANNEL_ID=

# Optional: category to create the sms-* contact channels under.
DISCORD_CATEGORY_ID=

# Optional: where one-time passcodes are sent. If REDACT_CODES is on and this
# is empty, passcodes are not written to Discord at all. Lock this channel down.
DISCORD_SECURE_CHANNEL_ID=

# ---------------------------------------------------------------------------
# SignalWire
# ---------------------------------------------------------------------------

# Space domain, without the scheme. e.g. example.signalwire.com
SIGNALWIRE_SPACE_URL=

SIGNALWIRE_PROJECT_ID=

# Used for REST auth when sending. A project can hold several API tokens; any
# valid one authenticates, so sending can work while inbound still 403s.
SIGNALWIRE_API_TOKEN=

# The key SignalWire signs inbound webhooks with, from the same API credentials
# page. This is a separate credential from the API token above — copy it, do not
# reuse the token. Wrong value means sending still works while every inbound
# message is rejected with a bad signature.
SIGNALWIRE_SIGNING_KEY=

# Your number in E.164 format. e.g. +14165550123
SIGNALWIRE_NUMBER=

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------

# Public HTTPS base URL SignalWire calls, with no trailing slash. This must
# match what SignalWire actually requests character for character — the
# signature is computed over the full URL.
PUBLIC_BASE_URL=https://sms.example.com

# Leave on. Only turn off for local testing without a tunnel.
VERIFY_SIGNATURE=true

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Divert or suppress messages that look like one-time passcodes.
REDACT_CODES=true

# Optional dead-man's-switch, pinged every 5 minutes. Without this, a host
# outage is silent — texts pile up in SignalWire's logs and nothing tells you.
HEARTBEAT_URL=

# Optional prefix overrides.
#COMMAND_PREFIX=!sms
#NOTE_PREFIX=//

# ---------------------------------------------------------------------------
# Runtime — Docker users can leave this whole section alone
# ---------------------------------------------------------------------------

# The image already sets BIND_HOST=0.0.0.0, BIND_PORT=8080 and
# DB_PATH=/data/bridge.sqlite3, which is what you want in a container.
#
# For the systemd install, uncomment these instead:
#BIND_HOST=127.0.0.1
#BIND_PORT=8080
#DB_PATH=/opt/sms-bridge/bridge.sqlite3

# ---------------------------------------------------------------------------
# Cloudflare Tunnel — docker-compose.yml only
# ---------------------------------------------------------------------------

# Zero Trust > Networks > Tunnels > create a tunnel > copy the token. Then add
# a public hostname routed to http://bridge:8080 and point PUBLIC_BASE_URL at it.
TUNNEL_TOKEN=
